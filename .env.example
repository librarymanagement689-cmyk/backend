# ==========================================
# Database Configuration
# ==========================================
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/library_management?retryWrites=true&w=majority
MONGODB_DATABASE=library_management

# ==========================================
# Security & JWT Authentication
# ==========================================
JWT_SECRET=generate-a-strong-random-secret-key-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==========================================
# Default Admin Credentials (initialized on first start)
# ==========================================
ADMIN_EMAIL=admin@library.com
ADMIN_INITIAL_PASSWORD=ChangeThisPassword123!

# ==========================================
# SMTP Email Notifications
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@library.com
REMINDER_DAYS_BEFORE_DUE=2

# ==========================================
# Allowed CORS Origins (Comma-separated URLs)
# Add your production frontend domain here!
# ==========================================
CORS_ORIGINS=https://your-frontend-domain.vercel.app,https://your-frontend-domain.netlify.app,http://localhost:4200

# ==========================================
# Cloudflare R2 Object Storage (Book Covers & Assets)
# ==========================================
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=lib2026
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://<bucket_public_subdomain>.r2.dev
